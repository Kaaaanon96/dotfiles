# Config generated by Ghostty Config
# https://ghostty.org/docs

desktop-notifications = true
title-report = true

macos-titlebar-style = native
window-theme = system
window-show-tab-bar = always
window-subtitle = working-directory
window-save-state = always

# 一旦`TERM=xterm-256color gcloud compute ssh`で接続する
# shell-integration-features = cursor,no-sudo,title,ssh-env,no-ssh-terminfo,path

font-size = 13
font-family = "UDEV Gothic 35JPDOC"
font-family = "UDEV Gothic 35NF"
font-family = "UDEV Gothic JPDOC"

# Colors
theme = Dracula
background = #282a36
foreground = #f8f8f2
selection-background = #44475a
selection-foreground = #ffffff
cursor-color = #f8f8f2
cursor-text = #282a36
palette = 0=#21222c
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff

# Bg
background = #1e1e2e
background-opacity = 0.95
background-blur = 40
background-image = ~/dotfiles/bg_img/092.jpg
background-image-opacity = 0.2
background-image-fit = cover

unfocused-split-opacity = 0.35

